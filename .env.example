# -----------------------------------------------------------------------------
# Nexolu Payments Core - configuracion de ejemplo
# Copiar a .env y completar. Nunca commitear el .env real.
#
# Las credenciales de CADA proveedor (Wompi, etc.) y el registro de que apps
# pueden llamar al Core NO van aca: son configurables en la base de datos
# (tablas `integrations` / `provider_credentials`), con
# `python -m scripts.register_integration`. Ver docs/APP_INTEGRATION.md.
# -----------------------------------------------------------------------------

# Persistencia. Por defecto SQLite (cero infraestructura para desarrollo local).
# En produccion usar Postgres: postgresql+asyncpg://user:pass@host:5432/nexolu_payments_core
DATABASE_URL=sqlite+aiosqlite:///./nexolu_payments_core.db

# Clave Fernet (32 bytes urlsafe base64) para cifrar en reposo las
# credenciales de proveedor guardadas en `provider_credentials`. Generar con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Sin esta clave el servicio arranca pero cualquier lectura/escritura de
# credenciales de proveedor falla explicitamente.
PAYMENTS_MASTER_KEY=

DEFAULT_CURRENCY=COP

# Timeout (segundos) al notificar a una app integradora su webhook.
WEBHOOK_TIMEOUT_SECONDS=10

LOG_LEVEL=INFO
