# Nexolu Payments Core - example configuration
# Copy to .env and never commit the real file.

DATABASE_URL=sqlite+aiosqlite:///./nexolu_payments_core.db

# Fernet master key used to encrypt provider secrets at rest.
PAYMENTS_MASTER_KEY=

# Server-side provisioning secret. Never expose this to a browser.
PROVISIONING_KEY=

DEFAULT_CURRENCY=COP
WEBHOOK_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO
